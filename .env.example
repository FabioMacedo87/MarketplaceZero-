# Public browser values. Safe to expose when Row Level Security is enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Server-only values. NEVER use VITE_ prefixes for these.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_SECRET

# Stripe production mode only. Subscriptions stay disabled until all values exist.
STRIPE_SECRET_KEY=rk_live_YOUR_RESTRICTED_LIVE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET
STRIPE_BILLING_PORTAL_CONFIGURATION=bpc_1Ug9Gr2VZXUfhutCKuxTaC3c
STRIPE_PRICE_ESSENCIAL=price_1Ug9FX2VZXUfhutCzzLhenRY
STRIPE_PRICE_PROFISSIONAL=price_1Ug9FZ2VZXUfhutCaGvShtFv
STRIPE_PRICE_EMPRESARIAL=price_1Ug9Fb2VZXUfhutCfQD1fx4S

# Canonical public HTTPS address of PublicaFix.
APP_URL=https://YOUR_PUBLICAFIX_DOMAIN

# Explicit commercial launch switch. Keep false until plan scope, price points, tax treatment and production settings are confirmed.
PUBLICAFIX_LIVE_BILLING_ENABLED=false
